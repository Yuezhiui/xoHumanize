# Copy to .env. Never commit real credentials.
XO_API_BASE=https://api.openai.com/v1
XO_API_KEY=
XO_MODEL=
# Set false for compatible providers without JSON mode.
XO_JSON_MODE=true
# For a local OpenAI-compatible server, set its /v1 base and installed model.
# Example base: http://localhost:11434/v1
HOST=127.0.0.1
PORT=4318
# Required when binding publicly; use HTTPS through a reverse proxy.
XO_ACCESS_TOKEN=
XO_ORIGIN=
